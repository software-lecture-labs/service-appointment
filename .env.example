# Bu dosyayı .env olarak kopyalayıp değerleri değiştirebilirsiniz (.env repoya eklenmez)
DB_NAME=service_appointment
DB_USERNAME=servis
DB_PASSWORD=servis
# 5432 yerel PostgreSQL kurulumlarıyla çakışmasın diye Docker veritabanı 5433'te yayınlanır
DB_PORT=5433
DB_URL=jdbc:postgresql://localhost:5433/service_appointment
